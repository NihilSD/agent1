# Discord bot token from https://discord.com/developers/applications
DISCORD_TOKEN=

# Which LLM backend to use for template structuring + field mapping: anthropic | openai
LLM_PROVIDER=anthropic

# Anthropic (used when LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# OpenAI (used when LLM_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Optional tuning
DB_PATH=data/templates.db
MAX_UPLOAD_MB=15
MAX_TEMPLATE_CHARS=12000
SCRAPE_TIMEOUT_MS=45000
SCRAPE_MAX_IMAGES=4
TEMP_DIR=temp
